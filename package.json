{
  "name": "@kaelyx/ts-kit",
  "version": "0.6.0",
  "description": "Small TypeScript utility functions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "homepage": "https://kaelyx.dev/ts-kit/",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaelyx-dev/ts-kit.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
