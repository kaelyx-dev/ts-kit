    "exports": "tsx scripts/exports.ts",
    "exports:check": "tsx scripts/exports.ts --check",
    "clean": "tsx scripts/clean.ts",
    "build": "npm run clean && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs": "tsx scripts/copy-docs.ts && typedoc && tsx scripts/inline-types.ts",
    "size": "tsx scripts/size.ts",
    "docs:check": "typedoc --emit none --validation.notDocumented --treatWarningsAsErrors",
    "docs:dev": "npm run docs && vitepress dev docs",
    "docs:build": "npm run docs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "npm run lint && npm run typecheck && npm run barrels:check && npm run exports:check && npm run test -- --coverage && npm run docs:check && npm run build && publint && attw --pack --ignore-rules cjs-resolves-to-esm --exclude-entrypoints package.json && npm run size"
