    "./result/unwrap": {
      "types": "./dist/result/unwrap.d.ts",
      "default": "./dist/result/unwrap.js"
    },
    "./result/unwrap-or": {
      "types": "./dist/result/unwrap-or.d.ts",
      "default": "./dist/result/unwrap-or.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "./string/exclamationmark": {
      "types": "./dist/string/exclamationmark.d.ts",
      "default": "./dist/string/exclamationmark.js"
    },
    "./string/fullstop": {
      "types": "./dist/string/fullstop.d.ts",
      "default": "./dist/string/fullstop.js"
    },
    "./string/is-json": {
      "types": "./dist/string/is-json.d.ts",
