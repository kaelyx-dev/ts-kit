      ],
      "number/clamp": [
        "./dist/number/clamp.d.ts"
      ],
      "object": [
        "./dist/object.d.ts"
      ],
      "object/from-query-string": [
        "./dist/object/from-query-string.d.ts"
      ],
      "object/omit": [
        "./dist/object/omit.d.ts"
      ],
      "object/pick": [
        "./dist/object/pick.d.ts"
      ],
      "object/to-query-string": [
