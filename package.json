      "types": "./dist/object/to-query-string.d.ts",
      "default": "./dist/object/to-query-string.js"
    },
    "./object/with-defaults": {
      "types": "./dist/object/with-defaults.d.ts",
      "default": "./dist/object/with-defaults.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "default": "./dist/result.js"
    },
    "./result/err": {
      "types": "./dist/result/err.d.ts",
      "default": "./dist/result/err.js"
